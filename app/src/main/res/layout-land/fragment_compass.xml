<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?colorSurfaceContainer">

    <uk.akane.omni.ui.components.CompassView
        android:id="@+id/compass_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="24dp"
        />

    <ImageView
        android:id="@+id/location_indicator"
        android:layout_width="28dp"
        android:layout_height="26dp"
        app:layout_constraintStart_toStartOf="@id/compass_view"
        app:layout_constraintEnd_toEndOf="@id/compass_view"
        app:layout_constraintBottom_toTopOf="@id/compass_view"
        android:src="@drawable/location_indicator"
        app:tint="?colorPrimary"
        android:layout_marginBottom="-4dp"
        android:importantForAccessibility="no"
        android:padding="2dp"
        />

    <TextView
        android:id="@+id/text_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="WE"
        android:textSize="45sp"
        android:textColor="?colorOnSurface"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="@id/compass_view"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_btn"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:icon="@drawable/ic_explorer"
        app:iconSize="28dp"
        app:backgroundTint="?colorSurface"
        app:iconTint="?colorOnSurface"
        app:strokeWidth="1dp"
        app:strokeColor="?colorSurfaceContainer"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_btn"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        app:layout_constraintEnd_toStartOf="@id/sheet_btn"
        app:layout_constraintTop_toTopOf="@id/sheet_btn"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:icon="@drawable/ic_settings"
        app:iconSize="28dp"
        app:backgroundTint="?colorSurface"
        app:iconTint="?colorOnSurface"
        app:strokeWidth="1dp"
        app:strokeColor="?colorSurfaceContainer"
        android:layout_marginEnd="16dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/not_available_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        app:icon="@drawable/ic_location_off_40dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:iconSize="40dp"
        app:backgroundTint="@android:color/transparent"
        app:iconTint="?colorOutline"
        app:layout_constraintStart_toEndOf="@id/compass_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="36dp"
        />

    <TextView
        android:id="@+id/city"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="New York, US"
        android:textSize="34sp"
        android:gravity="start"
        android:textColor="?colorOnSurface"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/compass_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sheet_btn"
        app:layout_constraintBottom_toTopOf="@id/latitude"
        app:layout_constraintVertical_bias="0.35"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        />

    <TextView
        android:id="@+id/latitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="40.7493"
        android:text="@string/position_default_text"
        android:includeFontPadding="false"
        android:textFontWeight="500"
        android:textColor="?colorOnSurface"
        android:visibility="gone"
        android:textSize="22sp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/city"
        app:layout_constraintEnd_toStartOf="@id/latitude_desc"
        app:layout_constraintBottom_toTopOf="@id/altitude"
        android:layout_marginBottom="6dp"
        />

    <TextView
        android:id="@+id/latitude_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/longitude_desc"
        android:textSize="22sp"
        android:visibility="gone"
        android:textFontWeight="500"
        android:textColor="?colorOutline"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/latitude"
        app:layout_constraintEnd_toStartOf="@id/longitude"
        app:layout_constraintBaseline_toBaselineOf="@id/latitude"
        android:layout_marginStart="8dp"
        />

    <TextView
        android:id="@+id/longitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="73.9679"
        android:text="@string/position_default_text"
        android:includeFontPadding="false"
        android:textFontWeight="500"
        android:textColor="?colorOnSurface"
        android:textSize="22sp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/latitude_desc"
        app:layout_constraintEnd_toStartOf="@id/longitude_desc"
        app:layout_constraintBaseline_toBaselineOf="@id/latitude"
        android:layout_marginStart="24dp"
        />

    <TextView
        android:id="@+id/longitude_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/latitude_desc"
        android:textSize="22sp"
        android:textColor="?colorOutline"
        android:textFontWeight="500"
        android:visibility="gone"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/longitude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/latitude"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        />

    <TextView
        android:id="@+id/altitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="124"
        android:text="@string/altitude_default_text"
        android:includeFontPadding="false"
        android:textFontWeight="500"
        android:textColor="?colorOnSurface"
        android:textSize="22sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/city"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="36dp"
        />

    <TextView
        android:id="@+id/altitude_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/altitude_unit_meter"
        android:textSize="22sp"
        android:textColor="?colorOutline"
        android:textFontWeight="500"
        android:visibility="gone"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/altitude"
        app:layout_constraintBaseline_toBaselineOf="@id/altitude"
        android:layout_marginStart="8dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
